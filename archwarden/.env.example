# NVIDIA NIM (get free key at https://build.nvidia.com)
NVIDIA_API_KEY=""
NVIDIA_API_BASE="https://integrate.api.nvidia.com/v1"

# Optional: Tavily for doc grounding
TAVILY_API_KEY=""

# Graph engine: "falkor" or "memory" (offline fallback)
ARCHWARDEN_GRAPH="falkor"

# FalkorDB connection
FALKORDB_HOST="localhost"
FALKORDB_PORT="6379"
FALKORDB_PASSWORD=""

# NVIDIA Nemotron model IDs (verify at runtime via client.models.list())
ARCHWARDEN_NANO="nvidia/nemotron-nano-8b-instruct"
ARCHWARDEN_SUPER="nvidia/nemotron-super-49b-v1"
ARCHWARDEN_ULTRA="nvidia/nemotron-4-340b-instruct"

# Archwarden tuning
ARCHWARDEN_K_HOPS="2"
ARCHWARDEN_MAX_PROMPT_TOKENS="12000"
ARCHWARDEN_MAX_DEPTH="3"
ARCHWARDEN_LIVE="1"
